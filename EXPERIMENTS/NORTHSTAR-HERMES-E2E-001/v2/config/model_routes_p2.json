    },
    "MORCH": {
      "runtime": "opencode",
      "provider": "opencode-go",
      "model": "opencode-go/glm-5.3-flash",
      "binary": "/home/psm/.opencode/bin/opencode",
      "timeout_seconds": 180
    }
  },
  "p2": {
    "fixture_spec": "retry_schedule_v1",
